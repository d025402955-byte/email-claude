# ===== מלא את הפרטים ושמור =====

# כתובת המייל שהבוט בודק ושולח ממנה
EMAIL_ADDRESS=your@gmail.com

# סיסמת אפליקציה של ג'ימייל (16 אותיות, בלי רווחים)
EMAIL_APP_PASSWORD=

# כתובות שמותר להן לשאול, מופרדות בפסיק. ריק = רק EMAIL_ADDRESS
ALLOWED_SENDERS=

# מילה שחייבת להיות בנושא המייל. ריק = כל מייל מכתובת מורשית
SUBJECT_TAG=שאלה

CHECK_EVERY_SECONDS=60

# ===== דף הניהול =====
# סיסמה לכניסה לדף הניהול (בחר סיסמה חזקה)
ADMIN_PASSWORD=
ADMIN_PORT=8090

# ===== שלוחת טלפון בטכנוליין (phone.py) =====
# מספרי טלפון שמותר להם לשאול בטלפון, מופרדים בפסיק. ריק = אף אחד
PHONE_ALLOWED=
# מחרוזת סודית שבכתובת השלוחה (install.sh יוצר אחת אם חסר)
PHONE_TOKEN=
PHONE_PORT=8091
# מאיפה לקחת את מפתח טכנוליין ואת הגדרות זיהוי הדיבור
SHMARTPHONE_CONFIG=/etc/shmartphone/app.json
