# ===== מלא את הפרטים ושמור =====

# כתובת המייל שהבוט בודק ושולח ממנה
EMAIL_ADDRESS=your@gmail.com

# סיסמת אפליקציה של ג'ימייל (16 אותיות, בלי רווחים)
EMAIL_APP_PASSWORD=

# כתובות שמותר להן לשאול, מופרדות בפסיק. ריק = רק EMAIL_ADDRESS
ALLOWED_SENDERS=

# מילה שחייבת להיות בנושא המייל. ריק = כל מייל מכתובת מורשית
SUBJECT_TAG=שאלה

CHECK_EVERY_SECONDS=60
