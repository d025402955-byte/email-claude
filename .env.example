# ===== העתק את הקובץ הזה ל- .env ומלא את הפרטים =====

# כתובת המייל שהבוט בודק ושולח ממנה
EMAIL_ADDRESS=your@gmail.com

# סיסמת אפליקציה של ג'ימייל (16 אותיות, בלי רווחים) - לא הסיסמה הרגילה!
EMAIL_APP_PASSWORD=

# מפתח API של Claude (מתחיל ב- sk-ant-)
ANTHROPIC_API_KEY=

# כתובות שמותר להן לשאול, מופרדות בפסיק. אם ריק - רק EMAIL_ADDRESS
ALLOWED_SENDERS=

# מילה שחייבת להיות בנושא המייל כדי שהבוט יענה. השאר ריק כדי שיענה לכל מייל מכתובת מורשית
SUBJECT_TAG=שאלה

# אופציונלי
MODEL=claude-sonnet-5-5
CHECK_EVERY_SECONDS=60
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
