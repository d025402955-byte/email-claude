[Unit]
Description=Email to Claude - admin page
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/email-claude
ExecStart=/usr/bin/python3 /opt/email-claude/admin.py
Restart=always
RestartSec=30
KillMode=process

[Install]
WantedBy=multi-user.target
